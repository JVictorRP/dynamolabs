# Copie para .env no VPS e preencha. NUNCA suba o .env para o GitHub.

# Domínio da área do cliente
APP_DOMAIN=app.dynamo.business
BETTER_AUTH_URL=https://app.dynamo.business
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Banco (o Postgres roda no próprio VPS, só acessível pela rede interna do Docker)
POSTGRES_USER=dynamo
POSTGRES_DB=dynamo
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgres://dynamo:COLE_A_MESMA_SENHA_DO_POSTGRES@db:5432/dynamo

# Nome da rede Docker do Traefik que já atende o n8n (ver docs/VPS-SETUP.md)
TRAEFIK_NETWORK=root_default
# Nome do "certresolver" configurado no Traefik do n8n (ver docs/VPS-SETUP.md)
TRAEFIK_CERTRESOLVER=mytlschallenge
