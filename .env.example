# Variáveis de ambiente do CRM.
# No Easypanel: serviço "crm" → aba Environment (cole uma por linha).
# No computador: copie para apps/crm/.env.local.

# Endereço público da área do cliente
BETTER_AUTH_URL=https://app.dynamo.business

# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Copie a "Internal Connection URL" do serviço Postgres no Easypanel
# (algo como postgres://postgres:SENHA@dynamo_crm-db:5432/dynamo)
DATABASE_URL=

# Chave da Dynamo para cadastrar clientes pela rota /api/admin/clientes.
# Gere com: openssl rand -hex 32  (sem ela, a rota fica desligada)
ADMIN_TOKEN=

# E-mails da equipe Dynamo que veem a área Clientes (/clientes), separados por vírgula.
# Ex.: DYNAMO_STAFF_EMAILS=voce@dynamo.business,colega@dynamo.business
DYNAMO_STAFF_EMAILS=

# Conteúdo e prévia para o cliente (ver docs/VPS-SETUP.md, seção 4.1)
# Pasta dos arquivos (no Docker já vem /data/content; monte um volume em /data no Easypanel)
# CONTENT_DIR=/data/content
# E-mail de avisos pelo Resend (opcional; plano grátis)
# RESEND_API_KEY=
# DYNAMO_NOTIFY_EMAILS=equipe@dynamo.business,outra@dynamo.business
# CONTENT_MAIL_FROM=Dynamo <avisos@mail.dynamo.business>
# Webhook do n8n para aprovações (opcional, https)
# CONTENT_NOTIFY_WEBHOOK_URL=

# Chatbot de WhatsApp (seção Chatbot): ver deploy/bot/README.md
# CHATBOT_ENC_KEY=   (openssl rand -base64 32; o mesmo valor no serviço do bot)
# ANTHROPIC_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# USD_BRL_RATE=5.50

# Só para banco externo que exija SSL (o Postgres do Easypanel não precisa)
# DATABASE_SSL=true

# Formulário de contato do site (rota /api/public/lead)
# Id da organização da própria Dynamo no CRM (recebe os leads do site)
PUBLIC_LEAD_ORGANIZATION_ID=
# Origens do site autorizadas (separadas por vírgula)
PUBLIC_LEAD_ALLOWED_ORIGINS=https://dynamo.business,https://www.dynamo.business
