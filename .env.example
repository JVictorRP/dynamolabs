# Variáveis de ambiente do CRM.
# No Easypanel: serviço "crm" → aba Environment (cole uma por linha).
# No computador: copie para apps/crm/.env.local.

# Endereço público da área do cliente
BETTER_AUTH_URL=https://app.dynamo.business

# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Copie a "Internal Connection URL" do serviço Postgres no Easypanel
# (algo como postgres://postgres:SENHA@dynamo_crm-db:5432/dynamo)
DATABASE_URL=

# Chave da Dynamo para cadastrar clientes pela rota /api/admin/clientes.
# Gere com: openssl rand -hex 32  (sem ela, a rota fica desligada)
ADMIN_TOKEN=

# Só para banco externo que exija SSL (o Postgres do Easypanel não precisa)
# DATABASE_SSL=true
