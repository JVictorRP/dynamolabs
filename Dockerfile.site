# Site institucional (dynamo.business): exportação estática do Next servida pelo nginx.
# Build (Easypanel): serviço App, Build → Dockerfile, arquivo Dockerfile.site, caminho /  (ver deploy/site/README.md)
FROM node:22-alpine AS builder
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter site...
# Variáveis NEXT_PUBLIC_* entram no JavaScript do navegador no momento do build.
ARG NEXT_PUBLIC_LEAD_ENDPOINT
ARG NEXT_PUBLIC_WHATSAPP_URL
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_INSTAGRAM_URL
ARG NEXT_PUBLIC_LINKEDIN_URL
# A trava de lançamento roda aqui: com pendências (copy provisória, sem endpoint ou WhatsApp) o build falha de propósito.
RUN pnpm --filter site check:release && pnpm --filter site build

FROM nginx:alpine AS runner
COPY apps/site/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/site/out /usr/share/nginx/html
EXPOSE 80
