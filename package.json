{
  "name": "dynamo-business",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:crm": "pnpm --filter crm dev",
    "build:crm": "pnpm --filter crm build",
    "db:generate": "pnpm --filter crm db:generate",
    "db:migrate": "pnpm --filter crm db:migrate",
    "dev:site": "pnpm --filter site dev",
    "build:site": "pnpm --filter site build",
    "test:site": "pnpm --filter site test",
    "dev:bot": "pnpm --filter bot dev",
    "build:bot": "pnpm --filter bot build",
    "test:bot": "pnpm --filter @dynamo/db test && pnpm --filter @dynamo/chatbot test && pnpm --filter bot test"
  }
}
